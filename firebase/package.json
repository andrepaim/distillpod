{
  "name": "distillpod-sync-contract",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-distillpod-sync 'npm test'",
    "test:storage": "firebase emulators:exec --only firestore,storage --project demo-distillpod-sync \"node --test --test-concurrency=1 storage-tests/*.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "firebase": "12.7.0",
    "firebase-tools": "15.5.1"
  }
}
